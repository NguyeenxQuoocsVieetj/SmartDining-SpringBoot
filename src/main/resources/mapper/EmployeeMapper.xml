<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springboot.smartdining.mapper.EmployeeMapper">

    <resultMap id="employeeResultMap" type="org.springboot.smartdining.entity.Employee">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="full_name" property="fullName"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="role" property="role"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="columns">
        id, username, password_hash, full_name, phone, email, avatar_url, role, status, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO employees (username, password_hash, full_name, phone, email, avatar_url, role, status, created_at)
        VALUES (
            #{username},
            #{passwordHash},
            #{fullName},
            #{phone,jdbcType=VARCHAR},
            #{email},
            #{avatarUrl,jdbcType=VARCHAR},
            <choose><when test="role != null">#{role}</when><otherwise>DEFAULT</otherwise></choose>,
            <choose><when test="status != null">#{status}</when><otherwise>DEFAULT</otherwise></choose>,
            <choose><when test="createdAt != null">#{createdAt}</when><otherwise>DEFAULT</otherwise></choose>
        )
    </insert>

    <select id="findById" resultMap="employeeResultMap">
        SELECT <include refid="columns"/>
        FROM employees
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="employeeResultMap">
        SELECT <include refid="columns"/>
        FROM employees
        ORDER BY id
    </select>

    <update id="update">
        UPDATE employees
        <set>
            username = #{username},
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
            full_name = #{fullName},
            phone = #{phone,jdbcType=VARCHAR},
            email = #{email},
            avatar_url = #{avatarUrl,jdbcType=VARCHAR},
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM employees
        WHERE id = #{id}
    </delete>

    <select id="findAdminId" resultType="long">
        SELECT id
        FROM employees
        WHERE role = 'ADMIN'
    </select>
</mapper>

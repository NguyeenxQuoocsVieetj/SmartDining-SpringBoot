<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springboot.smartdining.mapper.DiningTableMapper">

    <resultMap id="diningTableResultMap" type="org.springboot.smartdining.entity.DiningTable">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="qr_token" property="qrToken"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
    </resultMap>

    <sql id="columns">
        id, name, qr_token, status, version
    </sql>

    <insert id="insertRow" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO dining_tables (name, qr_token, status, version)
        VALUES (
            #{name},
            #{qrToken},
            <choose><when test="status != null">#{status}</when><otherwise>DEFAULT</otherwise></choose>,
            <choose><when test="version != null">#{version}</when><otherwise>DEFAULT</otherwise></choose>
        )
    </insert>

    <select id="findById" resultMap="diningTableResultMap">
        SELECT <include refid="columns"/>
        FROM dining_tables
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="diningTableResultMap">
        SELECT <include refid="columns"/>
        FROM dining_tables
        ORDER BY id
    </select>

    <update id="updateRow">
        UPDATE dining_tables
        <set>
            name = #{name},
            qr_token = #{qrToken},
            <if test="status != null">status = #{status},</if>
            version = version + 1,
        </set>
        WHERE id = #{id}
          AND version = #{version,jdbcType=INTEGER}
    </update>

    <delete id="deleteById">
        DELETE FROM dining_tables
        WHERE id = #{id}
    </delete>

    <select id="findByQrToken" resultMap="diningTableResultMap">
        SELECT <include refid="columns"/>
        FROM dining_tables
        WHERE qr_token = #{qrToken}
    </select>

    <select id="findByIdForUpdate" resultMap="diningTableResultMap" flushCache="true" useCache="false">
        SELECT <include refid="columns"/>
        FROM dining_tables
        WHERE id = #{id}
        FOR UPDATE
    </select>
</mapper>

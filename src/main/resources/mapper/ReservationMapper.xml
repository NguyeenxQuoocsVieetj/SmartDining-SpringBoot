<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springboot.smartdining.mapper.ReservationMapper">

    <resultMap id="reservationResultMap" type="org.springboot.smartdining.entity.Reservation">
        <id column="id" property="id"/>
        <result column="customer_name" property="customerName"/>
        <result column="phone" property="phone"/>
        <result column="arrival_time" property="arrivalTime"/>
        <result column="table_id" property="tableId"/>
        <result column="status" property="status"/>
        <result column="confirmed_by" property="confirmedBy"/>
        <result column="confirmed_at" property="confirmedAt"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="columns">
        id, customer_name, phone, arrival_time, table_id, status, confirmed_by, confirmed_at, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO reservations (customer_name, phone, arrival_time, table_id, status,
                                  confirmed_by, confirmed_at, created_at)
        VALUES (
            #{customerName},
            #{phone},
            #{arrivalTime},
            #{tableId,jdbcType=BIGINT},
            <choose><when test="status != null">#{status}</when><otherwise>DEFAULT</otherwise></choose>,
            #{confirmedBy,jdbcType=BIGINT},
            #{confirmedAt,jdbcType=TIMESTAMP},
            <choose><when test="createdAt != null">#{createdAt}</when><otherwise>DEFAULT</otherwise></choose>
        )
    </insert>

    <select id="findById" resultMap="reservationResultMap">
        SELECT <include refid="columns"/>
        FROM reservations
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="reservationResultMap">
        SELECT <include refid="columns"/>
        FROM reservations
        ORDER BY id
    </select>

    <update id="update">
        UPDATE reservations
        <set>
            customer_name = #{customerName},
            phone = #{phone},
            arrival_time = #{arrivalTime},
            table_id = #{tableId,jdbcType=BIGINT},
            <if test="status != null">status = #{status},</if>
            confirmed_by = #{confirmedBy,jdbcType=BIGINT},
            confirmed_at = #{confirmedAt,jdbcType=TIMESTAMP},
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM reservations
        WHERE id = #{id}
    </delete>

    <select id="countPendingByPhone" resultType="int">
        SELECT COUNT(*)
        FROM reservations
        WHERE phone = #{phone}
          AND status = 'PENDING'
    </select>

    <resultMap id="counterReservationResultMap" type="org.springboot.smartdining.dto.CounterReservationResponse">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="customer_name" javaType="string"/>
            <arg column="phone" javaType="string"/>
            <arg column="arrival_time" javaType="java.time.LocalDateTime"/>
            <arg column="table_id" javaType="long"/>
            <arg column="table_name" javaType="string"/>
            <arg column="status" javaType="org.springboot.smartdining.enums.ReservationStatus"/>
            <arg column="confirmed_by" javaType="long"/>
            <arg column="confirmed_at" javaType="java.time.LocalDateTime"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="counterSelect">
        SELECT r.id            AS id,
               r.customer_name AS customer_name,
               r.phone         AS phone,
               r.arrival_time  AS arrival_time,
               r.table_id      AS table_id,
               t.name          AS table_name,
               r.status        AS status,
               r.confirmed_by  AS confirmed_by,
               r.confirmed_at  AS confirmed_at,
               r.created_at    AS created_at
        FROM reservations r
        LEFT JOIN dining_tables t ON t.id = r.table_id
    </sql>

    <select id="search" resultMap="counterReservationResultMap">
        <include refid="counterSelect"/>
        <where>
            <if test="from != null">AND r.arrival_time &gt;= #{from}</if>
            <if test="to != null">AND r.arrival_time &lt; #{to}</if>
            <if test="status != null">AND r.status = #{status}</if>
            <if test="phone != null">AND r.phone = #{phone}</if>
        </where>
        ORDER BY r.arrival_time, r.id
    </select>
</mapper>

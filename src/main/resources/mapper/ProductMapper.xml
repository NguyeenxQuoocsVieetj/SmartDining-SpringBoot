<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springboot.smartdining.mapper.ProductMapper">

    <resultMap id="productResultMap" type="org.springboot.smartdining.entity.Product">
        <id column="id" property="id"/>
        <result column="category_id" property="categoryId"/>
        <result column="name" property="name"/>
        <result column="image_url" property="imageUrl"/>
        <result column="description" property="description"/>
        <result column="price" property="price"/>
        <result column="status" property="status"/>
    </resultMap>

    <sql id="columns">
        id, category_id, name, image_url, description, price, status
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO products (category_id, name, image_url, description, price, status)
        VALUES (
            #{categoryId},
            #{name},
            #{imageUrl,jdbcType=VARCHAR},
            #{description,jdbcType=VARCHAR},
            #{price},
            <choose><when test="status != null">#{status}</when><otherwise>DEFAULT</otherwise></choose>
        )
    </insert>

    <select id="findById" resultMap="productResultMap">
        SELECT <include refid="columns"/>
        FROM products
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="productResultMap">
        SELECT <include refid="columns"/>
        FROM products
        ORDER BY id
    </select>

    <update id="update">
        UPDATE products
        <set>
            category_id = #{categoryId},
            name = #{name},
            image_url = #{imageUrl,jdbcType=VARCHAR},
            description = #{description,jdbcType=VARCHAR},
            price = #{price},
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM products
        WHERE id = #{id}
    </delete>
</mapper>

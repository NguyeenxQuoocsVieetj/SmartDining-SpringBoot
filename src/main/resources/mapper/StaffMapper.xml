<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springboot.smartdining.mapper.StaffMapper">

    <resultMap id="itemResultMap" type="org.springboot.smartdining.dto.StaffItemResponse">
        <constructor>
            <idArg column="item_id" javaType="long"/>
            <arg column="order_id" javaType="long"/>
            <arg column="table_id" javaType="long"/>
            <arg column="table_name" javaType="string"/>
            <arg column="product_name" javaType="string"/>
            <arg column="quantity" javaType="int"/>
            <arg column="note" javaType="string"/>
            <arg column="status" javaType="org.springboot.smartdining.enums.OrderItemStatus"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="ready_at" javaType="java.time.LocalDateTime"/>
            <arg column="served_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="itemSelect">
        SELECT oi.id         AS item_id,
               oi.order_id   AS order_id,
               o.table_id    AS table_id,
               t.name        AS table_name,
               p.name        AS product_name,
               oi.quantity   AS quantity,
               oi.note       AS note,
               oi.status     AS status,
               oi.created_at AS created_at,
               oi.ready_at   AS ready_at,
               oi.served_at  AS served_at
        FROM order_items oi
        JOIN orders o ON o.id = oi.order_id
        JOIN dining_tables t ON t.id = o.table_id
        JOIN products p ON p.id = oi.product_id
    </sql>

    <select id="findReadyItems" resultMap="itemResultMap">
        <include refid="itemSelect"/>
        WHERE oi.status = 'READY'
          AND o.order_type = 'DINE_IN'
          AND o.status = 'UNPAID'
        ORDER BY oi.created_at, oi.id
    </select>

    <select id="findItemById" resultMap="itemResultMap">
        <include refid="itemSelect"/>
        WHERE oi.id = #{itemId}
    </select>

    <resultMap id="requestResultMap" type="org.springboot.smartdining.dto.StaffRequestResponse">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="table_id" javaType="long"/>
            <arg column="table_name" javaType="string"/>
            <arg column="request_type" javaType="org.springboot.smartdining.enums.TableRequestType"/>
            <arg column="service_type" javaType="string"/>
            <arg column="note" javaType="string"/>
            <arg column="requested_at" javaType="java.time.LocalDateTime"/>
            <arg column="amount_due" javaType="java.math.BigDecimal"/>
        </constructor>
    </resultMap>

    <select id="findPendingRequests" resultMap="requestResultMap">
        SELECT r.id            AS id,
               r.table_id      AS table_id,
               t.name          AS table_name,
               r.request_type  AS request_type,
               r.service_type  AS service_type,
               r.note          AS note,
               r.requested_at  AS requested_at,
               NULL            AS amount_due
        FROM table_requests r
        JOIN dining_tables t ON t.id = r.table_id
        WHERE r.status = 'PENDING'
        ORDER BY r.requested_at, r.id
    </select>
</mapper>
